{
    // --- UI & Theme ---
    "cli_default_open_behavior": "existing_window",
    "icon_theme": "Material Icon Theme",
    "use_system_path_prompts": false,
    "vim_mode": false,
    "theme": "Tokyo Night",
    "experimental.theme_overrides": {
        "background.appearance": "blurred",
        "background": "#00000090",
        "editor.background": "#00000030",
        "tab_bar.background": "#00000030",
    },
    "ui_font_size": 14,
    "buffer_font_size": 14,

    // Clean UI
    "scrollbar": {
        "show": "never",
    },
    "tabs": {
        "git_status": true,
    },

    // --- Editor Behavior ---
    "base_keymap": "None",
    "autosave": "on_focus_change",
    "soft_wrap": "editor_width",
    "tab_size": 4,
    "cursor_blink": false,

    // --- Search & Project ---
    "restore_on_startup": "launchpad",
    "project_panel": {
        "dock": "right",
        "default_width": 400,
        "hide_root": true,
        "auto_fold_dirs": false,
        "starts_open": false,
        "git_status": false,
        "sticky_scroll": false,
        "scrollbar": {
            "show": "never",
        },
        "indent_guides": {
            "show": "never",
        },
    },

    // --- Terminal (Great for Arch/Pentesting) ---
    "terminal": {
        "font_size": 14,
    },

    // --- AI & Agents ---
    "disable_ai": false,
    "agent_servers": {
        "opencode": {
            "type": "registry",
        },
        "qwen-code": {
            "type": "registry",
        },
        "gemini": {
            "type": "registry",
        },
    },
    "agent": {
        "dock": "left",
        "default_model": {
            "provider": "ollama",
            "model": "qwen2.5-coder:latest",
            "enable_thinking": false,
        },
        "favorite_models": [],
        "model_parameters": [],
    },

    // --- Core & System ---
    "enable_language_server": true,
    "session": {
        "trust_all_worktrees": true,
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
}
